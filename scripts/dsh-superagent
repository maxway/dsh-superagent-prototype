#!/usr/bin/env node
/**
 * Manage a local dsh-superagent service (one DSH profile, default `superagent`).
 *
 * `status`, `start`, and `restart` exit 0 while the service runs normally; 1 when it is stopped, duplicated, unreachable, or
 * reporting a runtime error, which `restart` may fix; 2 when it runs while a component such as a Source reports an error;
 * and 3 when it runs and waits for setup. A restart fixes neither 2 nor 3: they need a person.
 *
 * On POSIX, start runs the service in a tmux session and stop sends SIGINT. On Windows, start spawns a detached process and
 * stop asks DSH to exit through the management `POST service/stop` route, which works without POSIX signals. Status output,
 * exit codes, log names, the intentionally-stopped marker and the lock are the same on both.
 */
import { spawn, spawnSync } from 'node:child_process'
import { accessSync, closeSync, constants, existsSync, mkdirSync, openSync, readdirSync, readFileSync, realpathSync, rmSync, statSync,
  unlinkSync, writeFileSync } from 'node:fs'
import { createHash, randomUUID } from 'node:crypto'
import { request as httpRequest } from 'node:http'
import { request as httpsRequest } from 'node:https'
import { basename, delimiter, dirname, join, resolve } from 'node:path'
import { fileURLToPath } from 'node:url'

const PLATFORM = process.platform
const WINDOWS = PLATFORM === 'win32'
const SCRIPT = realpathSync(fileURLToPath(import.meta.url))
const ROOT = dirname(dirname(SCRIPT))
const ARTIFACTS = join(ROOT, '.artifacts')
const CONTROL = join(ARTIFACTS, 'control')
const KEEP_LOGS = 20
const LOCK_STALE_MS = 10 * 60_000
const PART_ERROR = 2
const SETUP_WAITS = 3

const sleep = (ms) => new Promise(resolve => setTimeout(resolve, ms))

/** Return the control directory for `profile`, creating it if needed. */
function control(profile) {
  const directory = join(CONTROL, 'profiles', profile)
  mkdirSync(directory, { recursive: true })
  return directory
}

/** Return whether `profile` was intentionally stopped. */
function stopped(profile) {
  return existsSync(join(control(profile), 'manually-stopped'))
}

/** Subcommands of this control script; a process running one reads or controls a service but is not the service. */
const CONTROL_ACTIONS = new Set(['start', 'stop', 'status', 'restart', 'watchdog'])
const SCRIPT_NAME = basename(SCRIPT)

/** Return whether command-line arguments belong to the main DSH service process for `profile`. */
export function serves(args, profile) {
  const words = []
  let matched = false
  let value = false
  for (const word of args.slice(1)) {
    if (value) { matched = matched || word === profile; value = false }
    else if (word === '--profile') value = true
    else if (word === `--profile=${profile}`) matched = true
    else if (!word.startsWith('-')) words.push(word.replace(/^"|"$/g, ''))
  }
  // This control script also accepts `--profile`; its own command line, and any concurrent control
  // invocation for the same profile, must not be mistaken for the DSH service process (issue found
  // by the stage 5 Windows smoke run).
  return matched && !words.some(word => word === 'plugin' || CONTROL_ACTIONS.has(word) || basename(word) === SCRIPT_NAME)
}

/** Parse `ps -o pid=,ucomm=,args=` output; whitespace splits the arguments, so only `--profile` and subcommands are inspected. */
export function parsePs(text) {
  return text.split('\n').flatMap(line => {
    const parts = line.trim().split(/\s+/)
    if (parts.length < 3 || !/^\d+$/.test(parts[0])) return []
    return [{ pid: Number(parts[0]), name: parts[1], args: parts.slice(2) }]
  })
}

function ps(options, check = false) {
  const result = spawnSync('ps', ['-ww', ...options, '-o', 'pid=,ucomm=,args='], { encoding: 'utf8' })
  if (result.error) throw result.error
  // `ps -p` exits 1 once the process is gone; only the full scan treats a failure as an error.
  if (check && result.status !== 0) throw new Error(`ps ${options.join(' ')} exited with code ${result.status}`)
  return parsePs(result.stdout ?? '')
}

/** Process names DSH runs under on Windows: the npm CLI (`node`/`dsh`) and the installed desktop app's host. */
const DSH_HOSTS = new Set(['node', 'dsh', 'deepseek harness'])
const isDshHost = name => DSH_HOSTS.has(String(name ?? '').replace(/\.exe$/i, '').toLowerCase())

/** Parse `Get-CimInstance Win32_Process` JSON into the same `{ pid, name, args }` records as `parsePs`. */
export function parseWindowsProcesses(value) {
  let parsed = value
  try { if (typeof value === 'string') parsed = JSON.parse(value) } catch { return [] }
  const list = Array.isArray(parsed) ? parsed : parsed ? [parsed] : []
  return list.flatMap(item => {
    if (!item || !Number.isInteger(item.ProcessId) || typeof item.CommandLine !== 'string') return []
    if (!isDshHost(item.Name)) return []
    return [{ pid: item.ProcessId, name: String(item.Name).replace(/\.exe$/i, '').toLowerCase(), args: item.CommandLine.split(/\s+/) }]
  })
}

function windowsProcesses() {
  const command = 'Get-CimInstance Win32_Process | Select-Object ProcessId,Name,CommandLine | ConvertTo-Json -Compress'
  const result = spawnSync('powershell.exe', ['-NoProfile', '-NonInteractive', '-Command', command], { encoding: 'utf8' })
  if (result.error) throw result.error
  return parseWindowsProcesses(result.stdout ?? '')
}

/** Whether a process record is a DSH service process for `profile`; the launcher's tmux or shell must not count as one. */
function serviceProcess(item, profile) {
  // Node may report its process name as a thread name such as MainThread; the executable in argv[0] still says node or dsh.
  // The desktop app runs DSH as `DeepSeek Harness.exe`, which the `dsh` shim on that host starts.
  const program = item.args?.[0] ? basename(item.args[0].replace(/^"|"$/g, '')).replace(/\.exe$/i, '').toLowerCase() : ''
  return (isDshHost(item.name) || isDshHost(program)) && serves(item.args, profile)
}

/** Return whether `pid` is currently running the DSH service for `profile`. */
function running(pid, profile) {
  if (pid === process.pid) return false
  const found = WINDOWS ? windowsProcesses().filter(item => item.pid === pid) : ps(['-p', String(pid)]).filter(item => item.pid === pid)
  return found.some(item => serviceProcess(item, profile))
}

/** Return PIDs of all running DSH service processes for `profile`, including instances started outside this script and a recorded PID that still runs it. */
function processes(profile) {
  // Exclude this control process itself, which also carries `--profile <name>` on its command line.
  const found = (WINDOWS ? windowsProcesses() : ps(['-ax'], true))
    .filter(item => item.pid !== process.pid).filter(item => serviceProcess(item, profile)).map(item => item.pid)
  let recorded
  try { recorded = Number(readFileSync(join(control(profile), 'service.pid'), 'utf8').trim()) } catch { return found }
  return Number.isInteger(recorded) && recorded > 0 && !found.includes(recorded) && running(recorded, profile) ? [...found, recorded] : found
}

function apiRequest(url, method, path, headers, timeout, content) {
  return new Promise(resolve => {
    let settled = false
    const finish = value => { if (!settled) { settled = true; resolve(value) } }
    let target
    try { target = new URL(url.replace(/\/+$/, '') + path) } catch { finish(null); return }
    const payload = content === undefined ? undefined : Buffer.from(content)
    let request
    try {
      request = (target.protocol === 'https:' ? httpsRequest : httpRequest)(target,
        { method, headers: payload ? { ...headers, 'content-type': 'application/json', 'content-length': String(payload.length) } : headers, timeout },
        response => {
          let body = ''
          response.setEncoding('utf8')
          response.on('data', chunk => { body += chunk })
          response.on('end', () => finish({ status: response.statusCode, body }))
          response.on('error', () => finish(null))
        })
    } catch { finish(null); return }
    request.on('timeout', () => { request.destroy(); finish(null) })
    request.on('error', () => finish(null))
    request.end(payload)
  })
}

/** Fetch health and setup status from the management API, or return null if unreachable. */
export async function state(url) {
  const response = await apiRequest(url, 'GET', '/orchestrator/api/state', { 'x-orchestrator-request': '1' }, 2_000)
  if (response === null || response.status < 200 || response.status >= 300) return null
  let value
  try { value = JSON.parse(response.body) } catch { return null }
  const health = value && typeof value === 'object' ? value.health ?? {} : {}
  const setup = value && typeof value === 'object' ? value.setup ?? {} : {}
  const entries = Object.fromEntries(Object.entries(health).map(([name, entry]) => [name, entry && typeof entry === 'object' ? entry : {}]))
  return {
    health: Object.fromEntries(Object.entries(entries).map(([name, entry]) => [name, entry.state])),
    errors: Object.fromEntries(Object.entries(entries).filter(([, entry]) => entry.state === 'error')
      .map(([name, entry]) => [name, String(entry.detail ?? '')])),
    setup: setup.problem,
    feishu: setup.feishuProblem,
  }
}

/** Return whether the runtime is ready or paused awaiting operator action; a component still starting does not hold this up. */
export function runtimeUp(current) {
  return current !== null && current !== undefined && (current.health?.runtime === 'ready' || current.health?.runtime === 'paused')
}

/** Return non-runtime components that are in an error state. */
export function partErrors(current) {
  return Object.fromEntries(Object.entries(current?.errors ?? {}).filter(([name]) => name !== 'runtime').sort(([a], [b]) => a.localeCompare(b)))
}

/** Compute the CLI exit code from running PIDs and management API state. */
export function outcome(pids, current) {
  if (pids.length !== 1 || !runtimeUp(current)) return 1
  if (current.setup) return SETUP_WAITS
  // A component's lasting error, unlike a Feishu bot check that failed during setup, requires operator action.
  return Object.keys(partErrors(current)).length ? PART_ERROR : 0
}

async function status(args) {
  const pids = processes(args.profile)
  const current = pids.length ? await state(args.url) : null
  const value = { pids, cwd: ROOT, url: args.url, manually_stopped: stopped(args.profile), health: current ? current.health : null,
    errors: current ? current.errors : null, setup: current ? current.setup : null, feishu: current ? current.feishu : null }
  process.stdout.write(JSON.stringify(value, null, 2) + '\n')
  return outcome(pids, current)
}

/** Fetch the Watchdog snapshot, or an error message the caller can report. */
async function watchdogSnapshot(url, staleMinutes) {
  const response = await apiRequest(url, 'GET', `/orchestrator/api/watchdog?stale_minutes=${staleMinutes}`,
    { 'x-orchestrator-request': '1' }, 10_000)
  if (response === null) return { error: `No management API answer at ${url}; the service may be down. Inspect it with status.` }
  if (response.status < 200 || response.status >= 300) {
    return { error: `The management API answered ${response.status}: ${response.body.trim().slice(0, 300)}` }
  }
  try {
    const value = JSON.parse(response.body)
    if (!value || typeof value !== 'object' || Array.isArray(value)) return { error: 'The management API answer is not a Watchdog snapshot.' }
    return { value }
  } catch { return { error: 'The management API answer is not JSON.' } }
}

/** The supervision facts the server audits with an action request; the server re-reads the Ticket and decides itself. */
function watchdogEvidence(ticket) {
  return { stage: ticket.stage, ...(ticket.action ? { action: ticket.action } : {}), silentMinutes: ticket.silentMinutes,
    signals: ticket.signals, ...(ticket.lastReport ? { lastReport: ticket.lastReport } : {}), attempts: ticket.attempts }
}

/**
 * Ask the management API to record or execute one retry or stop. The server owns the mode, safety checks, cooldown, limits
 * and audit; the command only supplies the reason and the snapshot it was based on, with a fresh idempotency key.
 */
async function watchdogAction(args) {
  const action = args.watchdog_action
  if (!args.ticket) throw new Error(`watchdog ${action} needs a ticket id`)
  const reason = (args.reason ?? '').trim()
  if (!reason) throw new Error(`watchdog ${action} needs --reason`)
  if (reason.length > 1000) throw new Error('--reason must be at most 1000 characters')
  const snapshot = await watchdogSnapshot(args.url, args.stale_minutes)
  if (snapshot.error) { process.stderr.write(snapshot.error + '\n'); return 1 }
  const ticket = snapshot.value.tickets?.find(item => item.id === args.ticket)
  if (!ticket) {
    process.stderr.write(`Ticket ${args.ticket} is not open; read the snapshot before asking for an action.\n`)
    return 1
  }
  const payload = JSON.stringify({ reason, evidence: watchdogEvidence(ticket), snapshotAt: snapshot.value.at, idempotencyKey: randomUUID() })
  const response = await apiRequest(args.url, 'POST', `/orchestrator/api/watchdog/tickets/${encodeURIComponent(args.ticket)}/${action}`,
    { 'x-orchestrator-request': '1' }, 10_000, payload)
  if (response === null) {
    process.stderr.write(`No management API answer at ${args.url}; the service may be down.\n`)
    return 1
  }
  if (response.status < 200 || response.status >= 300) {
    process.stderr.write(`The management API answered ${response.status}: ${response.body.trim().slice(0, 300)}\n`)
    return 1
  }
  let value
  try { value = JSON.parse(response.body) } catch {
    process.stderr.write('The management API answer is not JSON.\n')
    return 1
  }
  process.stdout.write(JSON.stringify(value, null, 2) + '\n')
  return 0
}

/**
 * Print the read-only snapshot an external Watchdog reads: service state, every open Ticket's stage, latest report,
 * silence and signals, the current Watchdog settings and the last decisions. The command only sends GET requests.
 */
async function watchdog(args) {
  const snapshot = await watchdogSnapshot(args.url, args.stale_minutes)
  if (snapshot.error) { process.stderr.write(snapshot.error + '\n'); return 1 }
  process.stdout.write(JSON.stringify({ profile: args.profile, url: args.url, ...snapshot.value }, null, 2) + '\n')
  return 0
}

/** Format the marker time like Python's `%Y-%m-%dT%H:%M:%S%z`, with the local UTC offset. */
function localStamp(now = new Date()) {
  const pad = value => String(value).padStart(2, '0')
  const offset = -now.getTimezoneOffset()
  const sign = offset >= 0 ? '+' : '-'
  return `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}T${pad(now.getHours())}:${pad(now.getMinutes())}:${pad(now.getSeconds())}`
    + `${sign}${pad(Math.floor(Math.abs(offset) / 60))}${pad(Math.abs(offset) % 60)}`
}

/** Ask DSH to exit through its management stop route; the route drains Executors and lets the launcher exit. */
export function stopRequest(url) {
  return apiRequest(url, 'POST', '/orchestrator/api/service/stop', { 'x-orchestrator-request': '1', 'content-length': '0' }, 10_000)
}

async function stop(args, intentional = true) {
  const pids = processes(args.profile)
  if (pids.length > 1) throw new Error('Multiple dsh-superagent processes found; refusing to choose one.')
  // Write the stop marker before waiting so monitors respect the intentional stop even if graceful shutdown times out.
  if (intentional) writeFileSync(join(control(args.profile), 'manually-stopped'), localStamp() + '\n')
  if (WINDOWS) {
    if (pids.length) await stopRequest(args.url)
  } else {
    for (const pid of pids) process.kill(pid, 'SIGINT')
  }
  const deadline = Date.now() + args.stop_timeout * 1000
  while (pids.some(pid => running(pid, args.profile))) {
    if (Date.now() >= deadline) throw new Error('Graceful stop timed out; no forced kill was sent. Check status.')
    await sleep(500)
  }
  rmSync(join(control(args.profile), 'service.pid'), { force: true })
  process.stdout.write(intentional ? 'dsh-superagent stopped. Automatic recovery is paused until start/restart.\n' : 'dsh-superagent stopped.\n')
}

function profileLogName(profile) {
  return new RegExp(`^dsh-superagent-${profile.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')}-\\d{8}-\\d{6}-\\d+\\.log$`)
}

/** Retain only the newest `KEEP_LOGS` log files for `profile`. */
function pruneLogs(profile) {
  const name = profileLogName(profile)
  const logs = readdirSync(ARTIFACTS).filter(entry => name.test(entry)).map(entry => join(ARTIFACTS, entry))
    .sort((a, b) => statSync(a).mtimeMs - statSync(b).mtimeMs)
  for (const path of logs.slice(0, Math.max(0, logs.length - KEEP_LOGS))) rmSync(path, { force: true })
}

function findExecutable(name) {
  const extensions = WINDOWS ? (process.env.PATHEXT ?? '.COM;.EXE;.BAT;.CMD').split(';').map(extension => extension.toLowerCase()).filter(Boolean) : ['']
  for (const directory of (process.env.PATH ?? '').split(delimiter).filter(Boolean)) {
    for (const extension of extensions) {
      const candidate = join(directory, name + extension)
      try {
        if (!statSync(candidate).isFile()) continue
        if (!WINDOWS) accessSync(candidate, constants.X_OK)
        return candidate
      } catch { /* Try the next candidate. */ }
    }
  }
  return undefined
}

/** Quote one word for a POSIX shell, as `shlex.quote` does. */
function shellQuote(word) {
  if (/^[A-Za-z0-9_@%+=:,./-]+$/.test(word)) return word
  return `'${word.replaceAll("'", "'\\''")}'`
}

/** The shell command a tmux pane runs: the caller's profile environment, without the tmux server's. */
export function tmuxCommand(dsh, profile, log, environment = process.env) {
  const values = ['DSH_HOME', 'HOME', 'PATH'].map(name => environment[name] === undefined
    ? `unset ${name}`
    : `export ${name}=${shellQuote(environment[name])}`)
  return `umask 077; ${values.join('; ')}; unset TMUX TMUX_PANE; exec `
    + `${[dsh, '--profile', profile, '--no-open'].map(shellQuote).join(' ')} >> ${shellQuote(log)} 2>&1`
}

/** The arguments that start the service in a tmux session; exported so the POSIX and Windows forms are testable. */
export function tmuxStart(target, dsh, profile, log, root = ROOT) {
  return [...target, '-d', '-P', '-F', '#{pane_pid}', '-n', 'server', '-c', root, tmuxCommand(dsh, profile, log)]
}

/** The profile-specific tmux socket name; a worker's `tmux kill-server` must not reach the service. */
export function tmuxSocket(profile) {
  return 'dsh-superagent-' + createHash('sha256').update(profile).digest('hex').slice(0, 20)
}

/** The invocation that starts the service detached on Windows; `dsh` is normally the npm `.cmd` shim. */
export function windowsStart(dsh, profile, node = findExecutable('node')) {
  if (/\.(cmd|bat)$/i.test(dsh)) {
    let text = ''
    try { text = readFileSync(dsh, 'utf8') } catch {}
    const entry = /(?:%~?dp0%?)[\\/]([^"'\r\n]+?\.(?:js|cjs|mjs))/i.exec(text)?.[1]
    if (entry) {
      const script = join(dirname(dsh), ...entry.split(/[\\/]+/))
      const adjacentNode = join(dirname(dsh), 'node.exe')
      const executable = existsSync(adjacentNode) ? adjacentNode : node
      if (!executable) throw new Error('node must be on PATH to start the npm dsh shim.')
      if (!existsSync(script)) throw new Error(`The dsh shim's Node entry does not exist: ${script}`)
      return { file: executable, args: [script, '--profile', profile, '--no-open'], shell: false }
    }
  }
  return { file: /\s/.test(dsh) ? `"${dsh}"` : dsh, args: ['--profile', profile, '--no-open'], shell: true }
}

async function start(args) {
  const session = 'dsh-' + args.profile
  let pids = processes(args.profile)
  if (pids.length > 1) throw new Error('Multiple dsh-superagent processes found; refusing to start another.')
  if (!pids.length) {
    const dsh = findExecutable('dsh')
    const tmux = WINDOWS ? 'tmux' : findExecutable('tmux')
    if (!dsh || !tmux) throw new Error(WINDOWS ? 'dsh must be on PATH.' : 'Both dsh and tmux must be on PATH.')
    const socket = WINDOWS ? undefined : tmuxSocket(args.profile)
    // Probe the tmux session before the URL so an existing orchestrator is still refused without touching tmux.
    const sessionExists = WINDOWS ? false : spawnSync('tmux', ['-L', socket, 'has-session', '-t', '=' + session]).status === 0
    if (await state(args.url) !== null) throw new Error('An existing orchestrator answers at this URL; refusing duplicate startup.')
    mkdirSync(ARTIFACTS, { recursive: true })
    const stamp = new Date()
    const pad = value => String(value).padStart(2, '0')
    const log = join(ARTIFACTS, `dsh-superagent-${args.profile}-${stamp.getFullYear()}${pad(stamp.getMonth() + 1)}${pad(stamp.getDate())}`
      + `-${pad(stamp.getHours())}${pad(stamp.getMinutes())}${pad(stamp.getSeconds())}-${process.pid}.log`)
    writeFileSync(log, '', { mode: 0o600 })
    pruneLogs(args.profile)
    if (WINDOWS) {
      const invocation = windowsStart(dsh, args.profile)
      const environment = { ...process.env }
      delete environment.TMUX
      delete environment.TMUX_PANE
      const output = openSync(log, 'a')
      const child = spawn(invocation.file, invocation.args, { detached: true, shell: invocation.shell, stdio: ['ignore', output, output],
        cwd: ROOT, windowsHide: true, env: environment })
      child.unref()
      closeSync(output)
      // The recorded PID is a convenience; the process scan is authoritative after a restart.
      const deadline = Date.now() + 5_000
      while (Date.now() < deadline && !processes(args.profile).length) await sleep(200)
      pids = processes(args.profile)
      if (pids.length) writeFileSync(join(control(args.profile), 'service.pid'), `${pids[0]}\n`)
    } else {
      const target = sessionExists ? ['new-window', '-t', '=' + session + ':'] : ['new-session', '-s', session]
      const started = spawnSync('tmux', ['-L', socket, ...tmuxStart(target, dsh, args.profile, log)], { encoding: 'utf8' })
      if (started.error) throw started.error
      if (started.status !== 0) throw new Error((started.stderr ?? '').trim() || `tmux exited with code ${started.status}`)
      const pane = (started.stdout ?? '').trim()
      if (/^\d+$/.test(pane)) writeFileSync(join(control(args.profile), 'service.pid'), pane + '\n')
    }
    process.stdout.write('Log: ' + log + '\n')
  } else {
    writeFileSync(join(control(args.profile), 'service.pid'), `${pids[0]}\n`)
    process.stdout.write(`dsh-superagent already running (PID ${pids[0]}); no duplicate started.\n`)
  }
  rmSync(join(control(args.profile), 'manually-stopped'), { force: true })
  const deadline = Date.now() + args.timeout * 1000
  while (Date.now() < deadline) {
    const current = await state(args.url)
    if (processes(args.profile).length && runtimeUp(current)) {
      const code = await status(args)
      if (current.setup) {
        process.stdout.write('dsh-superagent is waiting for setup: ' + String(current.setup.detail ?? '') + '\n')
        process.stdout.write('Open the URL DSH printed in the log, then the dsh-superagent overview.\n')
      }
      if (current.feishu) {
        process.stdout.write('dsh-superagent runs without Feishu: ' + String(current.feishu.detail ?? '') + '\n')
        process.stdout.write('Fix it on the Feishu card of the Source settings.\n')
      }
      for (const [name, detail] of Object.entries(partErrors(current))) {
        process.stdout.write(`${name} reports an error, which a restart does not fix: ${detail}\n`)
      }
      return code
    }
    await sleep(1000)
  }
  await status(args)
  throw new Error('Startup health check timed out; inspect the log. Any running process was left intact.')
}

/** Parse the command line the way the previous `argparse` interface did, including options before the action. */
export function parseArgv(argv, env = process.env) {
  const args = { action: undefined, watchdog_action: undefined, ticket: undefined, reason: undefined,
    profile: env.DSH_SUPERAGENT_PROFILE || 'superagent', url: env.DSH_SUPERAGENT_URL || 'http://127.0.0.1:3082',
    timeout: 60, stop_timeout: 300, stale_minutes: 30, respect_stop: false }
  const positionals = []
  const value = (index, name) => {
    const next = argv[index + 1]
    if (next === undefined || next.startsWith('-')) throw new Error(`${name} needs a value`)
    return next
  }
  /** A value that may itself start with `-`, such as a reason written as a sentence. */
  const text = (index, name) => {
    const next = argv[index + 1]
    if (next === undefined) throw new Error(`${name} needs a value`)
    return next
  }
  for (let index = 0; index < argv.length; index++) {
    const word = argv[index]
    if (word === '--profile') { args.profile = value(index, '--profile'); index++ }
    else if (word.startsWith('--profile=')) args.profile = word.slice('--profile='.length)
    else if (word === '--url') { args.url = value(index, '--url'); index++ }
    else if (word.startsWith('--url=')) args.url = word.slice('--url='.length)
    else if (word === '--timeout') { args.timeout = Number(value(index, '--timeout')); index++ }
    else if (word === '--stop-timeout') { args.stop_timeout = Number(value(index, '--stop-timeout')); index++ }
    else if (word === '--stale-minutes') { args.stale_minutes = Number(value(index, '--stale-minutes')); index++ }
    else if (word.startsWith('--stale-minutes=')) args.stale_minutes = Number(word.slice('--stale-minutes='.length))
    else if (word === '--reason') { args.reason = text(index, '--reason'); index++ }
    else if (word.startsWith('--reason=')) args.reason = word.slice('--reason='.length)
    else if (word === '--respect-stop') args.respect_stop = true
    else if (word === '-h' || word === '--help') args.help = true
    else if (word.startsWith('-')) throw new Error(`unrecognized option: ${word}`)
    else positionals.push(word)
  }
  args.action = positionals[0]
  if (args.action === 'watchdog') {
    args.watchdog_action = positionals[1]
    args.ticket = positionals[2]
    if (args.watchdog_action !== undefined && args.watchdog_action !== 'retry' && args.watchdog_action !== 'stop') {
      throw new Error('watchdog action must be retry or stop')
    }
    if (positionals.length > 3) throw new Error(`unexpected argument: ${positionals[3]}`)
    if ((args.watchdog_action === 'retry' || args.watchdog_action === 'stop') && !args.ticket) {
      throw new Error(`watchdog ${args.watchdog_action} needs a ticket id`)
    }
  } else if (positionals.length > 1) throw new Error(`unexpected argument: ${positionals[1]}`)
  if (args.help) return args
  if (!['start', 'stop', 'restart', 'status', 'watchdog'].includes(args.action)) throw new Error('action must be one of start, stop, restart, status, watchdog')
  if (!Number.isFinite(args.timeout) || !Number.isFinite(args.stop_timeout) || args.timeout <= 0 || args.stop_timeout <= 0) {
    throw new Error('--timeout and --stop-timeout must be positive')
  }
  if (!Number.isInteger(args.stale_minutes) || args.stale_minutes < 1 || args.stale_minutes > 1440) {
    throw new Error('--stale-minutes must be an integer between 1 and 1440')
  }
  if (!/^[A-Za-z0-9_][A-Za-z0-9_.-]*$/.test(args.profile)) throw new Error('--profile must be a DSH profile name')
  return args
}

/** Take the profile's control lock without waiting; a stale lock from a crashed operation is removed after ten minutes. */
function acquireLock(profile) {
  const lock = join(control(profile), 'operation.lock')
  const take = () => { mkdirSync(lock); return () => rmSync(lock, { recursive: true, force: true }) }
  try { return take() } catch (error) {
    if (error?.code !== 'EEXIST') throw error
    try {
      if (Date.now() - statSync(lock).mtimeMs < LOCK_STALE_MS) throw error
      rmSync(lock, { recursive: true, force: true })
      return take()
    } catch (retry) {
      if (retry?.code === 'EEXIST') throw new Error('Another dsh-superagent control operation is in progress.')
      throw retry
    }
  }
}

const USAGE = `Usage: dsh-superagent [--respect-stop] <start|stop|restart|status|watchdog> [options]

Manage a local dsh-superagent service (one DSH profile, default \`superagent\`).

\`watchdog\` prints a read-only JSON snapshot of the service, its open Tickets, the Watchdog settings and recent decisions;
\`watchdog retry|stop <ticket> --reason <text>\` asks the server to record or execute one action under those settings.
The server owns the mode (off, observe, report or enforce), safety checks, cooldown, limits and audit.

Options:
  --profile <name>       DSH profile that loads dsh-superagent (default: $DSH_SUPERAGENT_PROFILE or superagent).
  --url <url>            Health-check URL (default: $DSH_SUPERAGENT_URL or http://127.0.0.1:3082).
  --timeout <seconds>    Startup timeout (default: 60).
  --stop-timeout <s>     Graceful shutdown timeout (default: 300).
  --stale-minutes <n>    Watchdog signal threshold in minutes (default: 30, at most 1440).
  --reason <text>        Why \`watchdog retry|stop\` asks for an action (required, at most 1000 characters).
  --respect-stop         For monitoring: never start/restart after an intentional stop.`

async function main(argv = process.argv.slice(2)) {
  const args = parseArgv(argv)
  if (args.help) { process.stdout.write(USAGE + '\n'); return 0 }
  process.umask(0o077)
  // A Watchdog only reads the management API, so a control operation in progress must not block it.
  if (args.action === 'watchdog') {
    return args.watchdog_action === 'retry' || args.watchdog_action === 'stop' ? await watchdogAction(args) : await watchdog(args)
  }
  const release = acquireLock(args.profile)
  try {
    if (args.respect_stop && (args.action === 'start' || args.action === 'restart') && stopped(args.profile)) {
      process.stdout.write('Intentional stop is active; automatic recovery skipped.\n')
      return 0
    }
    if (args.action === 'status') return await status(args)
    if (args.action === 'stop' || args.action === 'restart') {
      // Only a stop keeps automatic recovery off; a restart whose stop timed out leaves it on.
      await stop(args, args.action === 'stop')
    }
    if (args.action === 'start' || args.action === 'restart') return await start(args)
    return 0
  } finally { release() }
}

if (process.argv[1] && (() => { try { return realpathSync(resolve(process.argv[1])) === SCRIPT } catch { return false } })()) {
  main().then(code => { process.exitCode = code }).catch(error => {
    process.stderr.write((error instanceof Error ? error.message : String(error)) + '\n')
    process.exitCode = 1
  })
}