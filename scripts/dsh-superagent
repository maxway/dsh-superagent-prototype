#!/usr/bin/env node
/**
 * Manage a local dsh-superagent service (one DSH profile, default `superagent`).
 *
 * `status`, `start`, and `restart` exit 0 while the service runs normally; 1 when it is stopped, duplicated, unreachable, or
 * reporting a runtime error, which `restart` may fix; 2 when it runs while a component such as a Source reports an error;
 * and 3 when it runs and waits for setup. A restart fixes neither 2 nor 3: they need a person.
 *
 * On POSIX, start runs the service in a tmux session and stop sends SIGINT. On Windows, start spawns a detached process and
 * stop asks DSH to exit through the management `POST service/stop` route, which works without POSIX signals. Status output,
 * exit codes, log names, the intentionally-stopped marker and the lock are the same on both.
 */
import { spawn, spawnSync } from 'node:child_process'
import { accessSync, closeSync, constants, existsSync, mkdirSync, openSync, readdirSync, readFileSync, realpathSync, renameSync, rmSync,
  statSync, unlinkSync, writeFileSync } from 'node:fs'
import { createHash, randomUUID } from 'node:crypto'
import { request as httpRequest } from 'node:http'
import { request as httpsRequest } from 'node:https'
import { basename, delimiter, dirname, join, resolve } from 'node:path'
import { homedir } from 'node:os'
import { fileURLToPath } from 'node:url'

const PLATFORM = process.platform
const WINDOWS = PLATFORM === 'win32'
const SCRIPT = realpathSync(fileURLToPath(import.meta.url))
const ROOT = dirname(dirname(SCRIPT))
const ARTIFACTS = join(ROOT, '.artifacts')
const CONTROL = join(ARTIFACTS, 'control')
const KEEP_LOGS = 20
const LOCK_STALE_MS = 10 * 60_000
const PART_ERROR = 2
const SETUP_WAITS = 3

const sleep = (ms) => new Promise(resolve => setTimeout(resolve, ms))

/** Return the control directory for `profile`, creating it if needed. */
function control(profile) {
  const directory = join(CONTROL, 'profiles', profile)
  mkdirSync(directory, { recursive: true })
  return directory
}

/** Return whether `profile` was intentionally stopped. */
function stopped(profile) {
  return existsSync(join(control(profile), 'manually-stopped'))
}

/** Run a PowerShell command and return its trimmed standard output; a failure carries the standard error. */
function runPowerShell(script, environment = process.env) {
  const result = spawnSync('powershell.exe', ['-NoProfile', '-NonInteractive', '-Command', script],
    { encoding: 'utf8', env: environment, windowsHide: true })
  if (result.error) throw result.error
  if (result.status !== 0) {
    throw new Error((result.stderr ?? '').trim() || `PowerShell exited with code ${result.status}`)
  }
  return (result.stdout ?? '').trim()
}

/**
 * The PowerShell that asks kernel32 whether a process belongs to a Job object. A DSH tool command runs in a Job with
 * `JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE`, so a service started from there dies when the tool command's Job closes; this is
 * how the control script tells that state apart from a normal terminal or Task Scheduler launch.
 */
const JOB_PROBE = '$ErrorActionPreference = \'Stop\'\n'
  + 'Add-Type -TypeDefinition @\'\n'
  + 'using System;\nusing System.Runtime.InteropServices;\npublic static class DshJobProbe {\n'
  + '  [DllImport("kernel32.dll", SetLastError = true)]\n  [return: MarshalAs(UnmanagedType.Bool)]\n'
  + '  public static extern bool IsProcessInJob(IntPtr processHandle, IntPtr jobHandle, out bool result);\n}\n'
  + '\'@\n'
  + '$process = Get-Process -Id __PID__ -ErrorAction Stop\n'
  + '$inJob = $false\n'
  + 'if (-not [DshJobProbe]::IsProcessInJob($process.Handle, [IntPtr]::Zero, [ref]$inJob)) { throw "IsProcessInJob failed" }\n'
  + 'if ($inJob) { "true" } else { "false" }'

/** Whether a Windows process belongs to any Job object; null when Windows cannot tell (or on another platform). */
export function processInJob(pid, run = runPowerShell) {
  if (!WINDOWS || !Number.isInteger(pid) || pid <= 0) return null
  try {
    const answer = run(JOB_PROBE.replace('__PID__', String(pid)))
    return answer === 'true' ? true : answer === 'false' ? false : null
  } catch { return null }
}

/**
 * The PowerShell that reports whether the Jobs a process belongs to can kill it. Plain membership says nothing: Node
 * puts a process into its own kill-on-close Job the first time it spawns a child, so a long-running service normally
 * belongs to a Job afterwards. A Job is the process's own when the process itself holds a handle to it; only a Job the
 * process merely inherited from its launch chain (a DSH tool command or a task) can kill it from outside. The probe
 * answers `none`, `own`, `foreign`, or `unknown`.
 */
const JOB_FACTS_PROBE = `
$ErrorActionPreference = 'Stop'
Add-Type -TypeDefinition @'
using System;
using System.Collections.Generic;
using System.Runtime.InteropServices;

public static class DshJobFacts
{
  [DllImport("ntdll.dll")] static extern int NtQuerySystemInformation(int kind, IntPtr buffer, int length, out int returned);
  [DllImport("kernel32.dll", SetLastError = true)] static extern IntPtr OpenProcess(uint access, bool inherit, int pid);
  [DllImport("kernel32.dll", SetLastError = true)] static extern bool DuplicateHandle(IntPtr sourceProcess, IntPtr source,
    IntPtr targetProcess, out IntPtr target, uint access, bool inherit, uint options);
  [DllImport("kernel32.dll", SetLastError = true)] static extern bool CloseHandle(IntPtr handle);
  [DllImport("kernel32.dll", SetLastError = true)] static extern bool IsProcessInJob(IntPtr process, IntPtr job, out bool result);
  [DllImport("kernel32.dll", SetLastError = true)] static extern IntPtr CreateJobObjectW(IntPtr attributes, string name);
  [DllImport("kernel32.dll")] static extern IntPtr GetCurrentProcess();

  [StructLayout(LayoutKind.Sequential)]
  struct HandleEntry
  {
    public IntPtr Object;
    public IntPtr ProcessId;
    public IntPtr Handle;
    public uint GrantedAccess;
    public ushort CreatorBackTraceIndex;
    public ushort ObjectTypeIndex;
    public uint HandleAttributes;
    public uint Reserved;
  }

  static HandleEntry Read(IntPtr buffer, long index, int stride)
  {
    return (HandleEntry)Marshal.PtrToStructure((IntPtr)(buffer.ToInt64() + 16 + index * stride), typeof(HandleEntry));
  }

  public static string Probe(int pid)
  {
    IntPtr own = CreateJobObjectW(IntPtr.Zero, null);
    if (own == IntPtr.Zero) return "unknown";
    try
    {
      int size = 1 << 24;
      IntPtr buffer = Marshal.AllocHGlobal(size);
      int returned;
      int status = NtQuerySystemInformation(64, buffer, size, out returned);
      while (status == unchecked((int)0xC0000004) && size < (1 << 28))
      {
        Marshal.FreeHGlobal(buffer);
        size <<= 1;
        buffer = Marshal.AllocHGlobal(size);
        status = NtQuerySystemInformation(64, buffer, size, out returned);
      }
      if (status != 0)
      {
        Marshal.FreeHGlobal(buffer);
        return "unknown";
      }
      try
      {
        long total = Marshal.ReadInt64(buffer);
        int stride = Marshal.SizeOf(typeof(HandleEntry));
        int self = System.Diagnostics.Process.GetCurrentProcess().Id;
        ushort jobKind = 0;
        bool known = false;
        for (long index = 0; index < total && !known; index++)
        {
          HandleEntry entry = Read(buffer, index, stride);
          if (entry.ProcessId.ToInt64() == self && entry.Handle == own)
          {
            jobKind = entry.ObjectTypeIndex;
            known = true;
          }
        }
        if (!known) return "unknown";
        IntPtr target = OpenProcess(0x1000, false, pid);
        if (target == IntPtr.Zero) return "unknown";
        try
        {
          bool inJob;
          if (!IsProcessInJob(target, IntPtr.Zero, out inJob)) return "unknown";
          if (!inJob) return "none";
          var holders = new Dictionary<long, List<KeyValuePair<int, IntPtr>>>();
          var owned = new HashSet<long>();
          for (long index = 0; index < total; index++)
          {
            HandleEntry entry = Read(buffer, index, stride);
            if (entry.ObjectTypeIndex != jobKind) continue;
            long key = entry.Object.ToInt64();
            int owner = (int)entry.ProcessId.ToInt64();
            if (owner == pid) owned.Add(key);
            List<KeyValuePair<int, IntPtr>> list;
            if (!holders.TryGetValue(key, out list)) { list = new List<KeyValuePair<int, IntPtr>>(); holders[key] = list; }
            list.Add(new KeyValuePair<int, IntPtr>(owner, entry.Handle));
          }
          bool contained = false;
          bool foreign = false;
          foreach (KeyValuePair<long, List<KeyValuePair<int, IntPtr>>> pair in holders)
          {
            bool tested = false;
            bool member = false;
            foreach (KeyValuePair<int, IntPtr> holder in pair.Value)
            {
              IntPtr process = OpenProcess(0x40, false, holder.Key);
              if (process == IntPtr.Zero) continue;
              IntPtr duplicate;
              bool copied = DuplicateHandle(process, holder.Value, GetCurrentProcess(), out duplicate, 0, false, 2);
              CloseHandle(process);
              if (!copied) continue;
              bool asked = IsProcessInJob(target, duplicate, out member);
              CloseHandle(duplicate);
              if (asked) { tested = true; break; }
            }
            if (!tested || !member) continue;
            contained = true;
            if (!owned.Contains(pair.Key)) foreign = true;
          }
          if (!contained) return "unknown";
          return foreign ? "foreign" : "own";
        }
        finally { CloseHandle(target); }
      }
      finally { Marshal.FreeHGlobal(buffer); }
    }
    finally { CloseHandle(own); }
  }
}
'@
[DshJobFacts]::Probe(__PID__)
`

/**
 * How a Windows process relates to the Jobs it belongs to: `inJob` is plain membership, `foreignJob` answers whether a
 * Job it does not own can kill it. Null when Windows cannot tell (or on another platform).
 */
export function processJobFacts(pid, run = runPowerShell) {
  if (!WINDOWS || !Number.isInteger(pid) || pid <= 0) return null
  try {
    const answer = run(JOB_FACTS_PROBE.replace('__PID__', String(pid)))
    if (answer === 'none') return { inJob: false, foreignJob: false }
    if (answer === 'own') return { inJob: true, foreignJob: false }
    if (answer === 'foreign') return { inJob: true, foreignJob: true }
    return null
  } catch { return null }
}

/** The PowerShell that asks the WMI provider to create a process outside the caller's Job and environment. */
const WMI_CREATE = '$ErrorActionPreference = \'Stop\'\n'
  + '$process = Invoke-CimMethod -ClassName Win32_Process -MethodName Create -Arguments @{ '
  + 'CommandLine = $env:DSH_OUTSIDE_JOB_COMMAND; CurrentDirectory = $env:DSH_OUTSIDE_JOB_CWD }\n'
  + 'if ($process.ReturnValue -ne 0) { throw "Win32_Process.Create returned $($process.ReturnValue)" }\n'
  + '$process.ProcessId'

/**
 * Create one process through WMI. The provider creates it with the caller's token in the caller's session but outside
 * every Windows Job and with the user's default environment, so the caller passes the environment explicitly.
 */
export function createOutsideJob(commandLine, cwd) {
  const answer = runPowerShell(WMI_CREATE, { ...process.env, DSH_OUTSIDE_JOB_COMMAND: commandLine, DSH_OUTSIDE_JOB_CWD: cwd })
  const pid = Number(answer.split(/\s+/).at(-1))
  if (!Number.isInteger(pid) || pid <= 0) throw new Error(`Win32_Process.Create returned no process id: ${answer.slice(0, 200)}`)
  return pid
}

/** Quote one argument for a Windows command line the way CreateProcess parses it. */
export function quoteWindowsArg(value) {
  const arg = String(value)
  if (arg === '') return '""'
  if (!/[\s"]/.test(arg)) return arg
  let quoted = '"'
  let backslashes = 0
  for (const character of arg) {
    if (character === '\\') { backslashes += 1; continue }
    if (character === '"') { quoted += '\\'.repeat(backslashes * 2 + 1) + '"'; backslashes = 0; continue }
    quoted += '\\'.repeat(backslashes) + character
    backslashes = 0
  }
  return quoted + '\\'.repeat(backslashes * 2) + '"'
}

/** The command line that runs `scripts/service-start.ps1`, the independent start wrapper, through WMI. */
export function outsideJobStartCommand(input) {
  return [input.shell, '-NoLogo', '-NoProfile', '-NonInteractive', '-File', input.wrapper,
    '-Checkout', input.checkout, '-EnvFile', input.environmentFile, '-Profile', input.profile, '-Url', input.url,
    '-Timeout', String(input.timeout), '-Log', input.log].map(quoteWindowsArg).join(' ')
}

/**
 * The environment a service needs that a WMI-created process would otherwise lose (it starts with the user's default
 * environment, not the caller's). It deliberately excludes unrelated variables, and it is written to an
 * access-restricted file rather than the command line so the model key never appears in a process listing.
 */
const START_ENVIRONMENT = ['PATH', 'PATHEXT', 'SystemRoot', 'ComSpec', 'TEMP', 'TMP', 'USERPROFILE', 'APPDATA', 'LOCALAPPDATA',
  'HOME', 'DSH_HOME', 'DSH_AGENTS_HOME', 'LUMOS_API_KEY', 'DSH_SUPERAGENT_PROFILE', 'DSH_SUPERAGENT_URL',
  'DSH_SUPERAGENT_DEPLOY_REQUEST', 'DSH_SUPERAGENT_DEPLOY_COMMAND']

/** Write the caller environment the independent start wrapper restores, restricted to the current account. */
export function writeStartEnvironment(profile, environment = process.env) {
  const path = join(control(profile), `start-environment-${process.pid}-${Date.now()}.json`)
  const value = Object.fromEntries(START_ENVIRONMENT.filter(name => environment[name] !== undefined)
    .map(name => [name, String(environment[name])]))
  writeFileSync(path, '{}', { mode: 0o600 })
  restrictWindowsLog(path)
  writeFileSync(path, `${JSON.stringify(value)}\n`, { mode: 0o600 })
  return path
}

/** The facts of the newest start, kept beside the profile's control files so `status` can show how the service began. */
function startFacts(profile) {
  try {
    const value = JSON.parse(readFileSync(join(control(profile), 'service-start.json'), 'utf8'))
    return value && typeof value === 'object' && !Array.isArray(value) ? value : null
  } catch { return null }
}

function recordStartFacts(profile, facts) {
  const path = join(control(profile), 'service-start.json')
  const temporary = `${path}.${process.pid}.tmp`
  writeFileSync(temporary, `${JSON.stringify(facts, null, 2)}\n`, { mode: 0o600 })
  renameSync(temporary, path)
}

/** The last lines of a start wrapper's log, for a failure a person can act on. */
function logTail(path, limit = 2_000) {
  try {
    const text = readFileSync(path, 'utf8')
    return text.length > limit ? text.slice(-limit) : text
  } catch { return '' }
}

/** Subcommands of this control script; a process running one reads or controls a service but is not the service. */
const CONTROL_ACTIONS = new Set(['start', 'stop', 'status', 'restart', 'watchdog', 'verify'])
const SCRIPT_NAME = basename(SCRIPT)

/** Return whether command-line arguments belong to the main DSH service process for `profile`. */
export function serves(args, profile) {
  const words = []
  let matched = false
  let value = false
  for (const word of args.slice(1)) {
    if (value) { matched = matched || word === profile; value = false }
    else if (word === '--profile') value = true
    else if (word === `--profile=${profile}`) matched = true
    else if (!word.startsWith('-')) words.push(word.replace(/^"|"$/g, ''))
  }
  // This control script also accepts `--profile`; its own command line, and any concurrent control
  // invocation for the same profile, must not be mistaken for the DSH service process (issue found
  // by the stage 5 Windows smoke run).
  return matched && !words.some(word => word === 'plugin' || CONTROL_ACTIONS.has(word) || basename(word) === SCRIPT_NAME)
}

/** Parse `ps -o pid=,ucomm=,args=` output; whitespace splits the arguments, so only `--profile` and subcommands are inspected. */
export function parsePs(text) {
  return text.split('\n').flatMap(line => {
    const parts = line.trim().split(/\s+/)
    if (parts.length < 3 || !/^\d+$/.test(parts[0])) return []
    return [{ pid: Number(parts[0]), name: parts[1], args: parts.slice(2) }]
  })
}

function ps(options, check = false) {
  const result = spawnSync('ps', ['-ww', ...options, '-o', 'pid=,ucomm=,args='], { encoding: 'utf8' })
  if (result.error) throw result.error
  // `ps -p` exits 1 once the process is gone; only the full scan treats a failure as an error.
  if (check && result.status !== 0) throw new Error(`ps ${options.join(' ')} exited with code ${result.status}`)
  return parsePs(result.stdout ?? '')
}

/** Process names DSH runs under on Windows: the npm CLI (`node`/`dsh`) and the installed desktop app's host. */
const DSH_HOSTS = new Set(['node', 'dsh', 'deepseek harness'])
const isDshHost = name => DSH_HOSTS.has(String(name ?? '').replace(/\.exe$/i, '').toLowerCase())

/** Parse `Get-CimInstance Win32_Process` JSON into the same `{ pid, name, args }` records as `parsePs`. */
export function parseWindowsProcesses(value) {
  let parsed = value
  try { if (typeof value === 'string') parsed = JSON.parse(value) } catch { return [] }
  const list = Array.isArray(parsed) ? parsed : parsed ? [parsed] : []
  return list.flatMap(item => {
    if (!item || !Number.isInteger(item.ProcessId) || typeof item.CommandLine !== 'string') return []
    if (!isDshHost(item.Name)) return []
    return [{ pid: item.ProcessId, name: String(item.Name).replace(/\.exe$/i, '').toLowerCase(), args: item.CommandLine.split(/\s+/) }]
  })
}

/** List DSH host processes through PowerShell; the hidden window keeps a control-script scan off the operator's desktop. */
export function windowsProcesses(run = spawnSync) {
  const command = 'Get-CimInstance Win32_Process | Select-Object ProcessId,Name,CommandLine | ConvertTo-Json -Compress'
  const result = run('powershell.exe', ['-NoProfile', '-NonInteractive', '-Command', command], { encoding: 'utf8', windowsHide: true })
  if (result.error) throw result.error
  return parseWindowsProcesses(result.stdout ?? '')
}

/** Whether a process record is a DSH service process for `profile`; the launcher's tmux or shell must not count as one. */
function serviceProcess(item, profile) {
  // Node may report its process name as a thread name such as MainThread; the executable in argv[0] still says node or dsh.
  // The desktop app runs DSH as `DeepSeek Harness.exe`, which the `dsh` shim on that host starts.
  const program = item.args?.[0] ? basename(item.args[0].replace(/^"|"$/g, '')).replace(/\.exe$/i, '').toLowerCase() : ''
  return (isDshHost(item.name) || isDshHost(program)) && serves(item.args, profile)
}

/** Return whether `pid` is currently running the DSH service for `profile`. */
function running(pid, profile) {
  if (pid === process.pid) return false
  const found = WINDOWS ? windowsProcesses().filter(item => item.pid === pid) : ps(['-p', String(pid)]).filter(item => item.pid === pid)
  return found.some(item => serviceProcess(item, profile))
}

/** Return PIDs of all running DSH service processes for `profile`, including instances started outside this script and a recorded PID that still runs it. */
function processes(profile) {
  // Exclude this control process itself, which also carries `--profile <name>` on its command line.
  const found = (WINDOWS ? windowsProcesses() : ps(['-ax'], true))
    .filter(item => item.pid !== process.pid).filter(item => serviceProcess(item, profile)).map(item => item.pid)
  let recorded
  try { recorded = Number(readFileSync(join(control(profile), 'service.pid'), 'utf8').trim()) } catch { return found }
  return Number.isInteger(recorded) && recorded > 0 && !found.includes(recorded) && running(recorded, profile) ? [...found, recorded] : found
}

function apiRequest(url, method, path, headers, timeout, content) {
  return new Promise(resolve => {
    let settled = false
    const finish = value => { if (!settled) { settled = true; resolve(value) } }
    let target
    try { target = new URL(url.replace(/\/+$/, '') + path) } catch { finish(null); return }
    const payload = content === undefined ? undefined : Buffer.from(content)
    let request
    try {
      request = (target.protocol === 'https:' ? httpsRequest : httpRequest)(target,
        { method, headers: payload ? { ...headers, 'content-type': 'application/json', 'content-length': String(payload.length) } : headers, timeout },
        response => {
          let body = ''
          response.setEncoding('utf8')
          response.on('data', chunk => { body += chunk })
          response.on('end', () => finish({ status: response.statusCode, body }))
          response.on('error', () => finish(null))
        })
    } catch { finish(null); return }
    request.on('timeout', () => { request.destroy(); finish(null) })
    request.on('error', () => finish(null))
    request.end(payload)
  })
}

/** Fetch health and setup status from the management API, or return null if unreachable. */
export async function state(url) {
  const response = await apiRequest(url, 'GET', '/orchestrator/api/state', { 'x-orchestrator-request': '1' }, 2_000)
  if (response === null || response.status < 200 || response.status >= 300) return null
  let value
  try { value = JSON.parse(response.body) } catch { return null }
  const health = value && typeof value === 'object' ? value.health ?? {} : {}
  const setup = value && typeof value === 'object' ? value.setup ?? {} : {}
  const entries = Object.fromEntries(Object.entries(health).map(([name, entry]) => [name, entry && typeof entry === 'object' ? entry : {}]))
  return {
    health: Object.fromEntries(Object.entries(entries).map(([name, entry]) => [name, entry.state])),
    errors: Object.fromEntries(Object.entries(entries).filter(([, entry]) => entry.state === 'error')
      .map(([name, entry]) => [name, String(entry.detail ?? '')])),
    setup: setup.problem,
    feishu: setup.feishuProblem,
  }
}

/** Return whether the runtime is ready or paused awaiting operator action; a component still starting does not hold this up. */
export function runtimeUp(current) {
  return current !== null && current !== undefined && (current.health?.runtime === 'ready' || current.health?.runtime === 'paused')
}

/** Return non-runtime components that are in an error state. */
export function partErrors(current) {
  return Object.fromEntries(Object.entries(current?.errors ?? {}).filter(([name]) => name !== 'runtime').sort(([a], [b]) => a.localeCompare(b)))
}

/** Compute the CLI exit code from running PIDs and management API state. */
export function outcome(pids, current) {
  if (pids.length !== 1 || !runtimeUp(current)) return 1
  if (current.setup) return SETUP_WAITS
  // A component's lasting error, unlike a Feishu bot check that failed during setup, requires operator action.
  return Object.keys(partErrors(current)).length ? PART_ERROR : 0
}

/** Read the service's process, health and ownership facts without printing them. */
async function statusValue(args) {
  const pids = processes(args.profile)
  const current = pids.length ? await state(args.url) : null
  const job = WINDOWS && pids.length === 1 ? processJobFacts(pids[0]) : null
  const inJob = job ? job.inJob : null
  const foreignJob = job ? job.foreignJob : null
  const value = { pids, cwd: ROOT, url: args.url, profile: args.profile, manually_stopped: stopped(args.profile),
    deployment: deploymentFacts(args.profile, args.home), health: current ? current.health : null,
    errors: current ? current.errors : null, setup: current ? current.setup : null, feishu: current ? current.feishu : null,
    inJob, foreignJob, start: startFacts(args.profile) }
  return { pids, current, inJob, foreignJob, value }
}

async function status(args) {
  const { pids, current, value } = await statusValue(args)
  process.stdout.write(JSON.stringify(value, null, 2) + '\n')
  return outcome(pids, current)
}

/**
 * Read the checkout's revision, branch and dirtiness with one hidden Git process; undefined when Git cannot answer.
 * `git status --porcelain=v2 --branch` carries all three facts, so a status call no longer starts two extra rev-parse
 * processes that would each need their own hidden window.
 */
function gitFacts() {
  try {
    const result = spawnSync('git', ['-C', ROOT, 'status', '--porcelain=v2', '--branch'], { encoding: 'utf8', windowsHide: true })
    if (result.error || result.status !== 0) return undefined
    const lines = (result.stdout ?? '').split(/\r?\n/)
    const header = name => lines.find(line => line.startsWith(`# ${name} `))?.slice(name.length + 3)
    const head = header('branch.oid')
    if (!head || !/^[0-9a-f]{40}$/.test(head)) return undefined
    const branch = header('branch.head')
    return {
      head,
      // A detached checkout keeps the value `rev-parse --abbrev-ref HEAD` reported before this probe changed shape.
      branch: !branch || branch === '(detached)' ? 'HEAD' : branch,
      dirty: lines.some(line => line !== '' && !line.startsWith('#')),
    }
  } catch { return undefined }
}

/** The configured state directory from the profile's patch, read without loading or changing the profile. */
function configuredStateDir(home, profile) {
  try {
    const text = readFileSync(join(home, 'profiles', profile, 'cordis.patch.yml'), 'utf8')
    return /^\s*stateDir:\s*["']?([^"'\r\n]+)["']?\s*$/m.exec(text)?.[1]?.trim()
  } catch { return undefined }
}

/**
 * The stable deployment facts a release supervisor would otherwise rediscover: the DSH home and profile directory, the
 * service script, the configured state directory, the bundle link and its target, the checkout revision and the built
 * `lib`. Read-only; a missing path or an unavailable Git answer is omitted rather than guessed.
 */
export function deploymentFacts(profile, home = process.env.DSH_HOME || join(homedir(), '.dsh')) {
  const profileDir = join(home, 'profiles', profile)
  const bundleLink = join(profileDir, 'node_modules', 'dsh-superagent')
  let bundle
  try { bundle = realpathSync(bundleLink) } catch {}
  const lib = join(ROOT, 'lib')
  let libFacts
  try {
    const stat = statSync(lib)
    libFacts = { path: lib, modifiedAt: stat.mtime.toISOString(), files: readdirSync(lib).length }
  } catch {}
  const git = gitFacts()
  return {
    profile, home, profileDir, serviceScript: existsSync(join(home, 'service.ps1')) ? join(home, 'service.ps1') : undefined,
    stateDir: configuredStateDir(home, profile), bundleLink, ...bundle ? { bundleTarget: bundle } : {},
    ...git ? { git } : {},
    ...libFacts ? { lib: libFacts } : {},
  }
}

/**
 * Prove the service survived the independent deployment executor's exit: exactly one process runs the profile, the
 * management API answers ready (or paused), the process belongs to no Windows Job it did not create itself, and it is
 * the same process after a survival window. This is the acceptance check the deployment task runs after the DSH agent
 * has exited. A service that spawns any child joins its own kill-on-close Job; the service holds that Job, so only a
 * Job inherited from the launch chain can kill it from outside.
 */
async function verify(args) {
  const at = new Date().toISOString()
  const fail = message => { process.stderr.write(message + '\n'); return 1 }
  const jobProblem = (facts, when) => {
    if (facts.foreignJob === true) {
      return `The service is inside a Windows Job it does not own${when}; that Job can kill it when it closes. `
        + 'Restart it outside the Job.'
    }
    if (facts.foreignJob !== false) {
      return 'Could not determine whether the service is only inside Windows Jobs it created itself' + when + '; '
        + 'survival cannot be proven.'
    }
    return undefined
  }
  const first = await statusValue(args)
  if (first.pids.length !== 1) return fail(`Expected exactly one running service for ${args.profile}; found ${first.pids.length}.`)
  if (!runtimeUp(first.current)) return fail('The management API did not answer ready (or paused); the service is not usable.')
  if (WINDOWS) {
    const problem = jobProblem(first, '')
    if (problem) return fail(problem)
  }
  const pid = first.pids[0]
  if (args.survival_seconds > 0) await sleep(args.survival_seconds * 1_000)
  const second = await statusValue(args)
  if (second.pids.length !== 1 || second.pids[0] !== pid) {
    return fail(`The service did not keep its process across the ${args.survival_seconds}s survival window; it was ${pid}.`)
  }
  if (!runtimeUp(second.current)) return fail('The management API stopped answering usable within the survival window.')
  if (WINDOWS) {
    const problem = jobProblem(second, ' after the survival window')
    if (problem) return fail(problem)
  }
  const value = { ok: true, at, pid, url: args.url, profile: args.profile, inJob: second.inJob,
    foreignJob: second.foreignJob, survivalSeconds: args.survival_seconds, health: second.current.health,
    start: second.value.start }
  process.stdout.write(JSON.stringify(value, null, 2) + '\n')
  return 0
}

/** Fetch the Watchdog snapshot, or an error message the caller can report. */
async function watchdogSnapshot(url, staleMinutes) {
  const response = await apiRequest(url, 'GET', `/orchestrator/api/watchdog?stale_minutes=${staleMinutes}`,
    { 'x-orchestrator-request': '1' }, 10_000)
  if (response === null) return { error: `No management API answer at ${url}; the service may be down. Inspect it with status.` }
  if (response.status < 200 || response.status >= 300) {
    return { error: `The management API answered ${response.status}: ${response.body.trim().slice(0, 300)}` }
  }
  try {
    const value = JSON.parse(response.body)
    if (!value || typeof value !== 'object' || Array.isArray(value)) return { error: 'The management API answer is not a Watchdog snapshot.' }
    return { value }
  } catch { return { error: 'The management API answer is not JSON.' } }
}

/**
 * Ask the management API to render the current Watchdog observation and post it to a Feishu chat as the bot. The server
 * owns the bot, the summary and the chat delivery; the command only names the chat, an optional one-sentence judgement
 * and a fresh idempotency key, so a retried call does not duplicate the message.
 */
async function watchdogReport(args) {
  const payload = JSON.stringify({ chatId: args.chat, ...(args.note ? { note: args.note } : {}), idempotencyKey: randomUUID() })
  const response = await apiRequest(args.url, 'POST', '/orchestrator/api/watchdog/report',
    { 'x-orchestrator-request': '1' }, 20_000, payload)
  if (response === null) {
    process.stderr.write(`No management API answer at ${args.url}; the service may be down.\n`)
    return 1
  }
  if (response.status < 200 || response.status >= 300) {
    process.stderr.write(`The management API answered ${response.status}: ${response.body.trim().slice(0, 300)}\n`)
    return 1
  }
  let value
  try { value = JSON.parse(response.body) } catch {
    process.stderr.write('The management API answer is not JSON.\n')
    return 1
  }
  process.stdout.write(JSON.stringify(value, null, 2) + '\n')
  return 0
}

/**
 * Ask the management API to record this check as one observation run: the live snapshot, the rendered observation and an
 * optional one-sentence judgement. A fresh idempotency key lets a retried call avoid a duplicate record.
 */
async function watchdogRecord(args) {
  const note = (args.note ?? '').trim()
  const payload = JSON.stringify({ ...(note ? { note } : {}), idempotencyKey: randomUUID() })
  const response = await apiRequest(args.url, 'POST', '/orchestrator/api/watchdog/runs',
    { 'x-orchestrator-request': '1' }, 10_000, payload)
  if (response === null) {
    process.stderr.write(`No management API answer at ${args.url}; the service may be down.\n`)
    return 1
  }
  if (response.status < 200 || response.status >= 300) {
    process.stderr.write(`The management API answered ${response.status}: ${response.body.trim().slice(0, 300)}\n`)
    return 1
  }
  let value
  try { value = JSON.parse(response.body) } catch {
    process.stderr.write('The management API answer is not JSON.\n')
    return 1
  }
  process.stdout.write(JSON.stringify(value, null, 2) + '\n')
  return 0
}

/** Print the recent observation runs, newest first, so a person can read what the scheduled check saw. */
async function watchdogRuns(args) {
  const response = await apiRequest(args.url, 'GET', `/orchestrator/api/watchdog/runs?limit=${args.limit}`,
    { 'x-orchestrator-request': '1' }, 10_000)
  if (response === null) {
    process.stderr.write(`No management API answer at ${args.url}; the service may be down.\n`)
    return 1
  }
  if (response.status < 200 || response.status >= 300) {
    process.stderr.write(`The management API answered ${response.status}: ${response.body.trim().slice(0, 300)}\n`)
    return 1
  }
  let value
  try { value = JSON.parse(response.body) } catch {
    process.stderr.write('The management API answer is not JSON.\n')
    return 1
  }
  process.stdout.write(JSON.stringify(value, null, 2) + '\n')
  return 0
}

/**
 * Request one bounded recovery for a Ticket whose worker Session is missing. The server checks the live Session,
 * the snapshot freshness, the enforce mode and the per-Session retry ceiling; this command never restarts the service.
 */
async function watchdogRecover(args) {
  const idempotencyKey = args.idempotency_key || `watchdog-recovery-${args.ticket}-${Date.parse(args.snapshot_at)}`
  const payload = JSON.stringify({ ticketId: args.ticket, action: 'retry', reason: args.reason,
    snapshotAt: args.snapshot_at, idempotencyKey })
  const response = await apiRequest(args.url, 'POST', '/orchestrator/api/watchdog/recoveries',
    { 'x-orchestrator-request': '1' }, 10_000, payload)
  if (response === null) {
    process.stderr.write(`No management API answer at ${args.url}; the service may be down.\n`)
    return 1
  }
  if (response.status < 200 || response.status >= 300) {
    process.stderr.write(`The management API answered ${response.status}: ${response.body.trim().slice(0, 300)}\n`)
    return 1
  }
  let record
  try { record = JSON.parse(response.body) } catch {
    process.stderr.write('The management API answer is not JSON.\n')
    return 1
  }
  process.stdout.write(JSON.stringify(record, null, 2) + '\n')
  return record?.result === 'executed' ? 0 : 1
}

/**
 * Print the read-only snapshot an external Watchdog reads: service state, every open Ticket's stage, latest report,
 * silence and signals, and the last recorded observation. The command only sends GET requests.
 */
async function watchdog(args) {
  const snapshot = await watchdogSnapshot(args.url, args.stale_minutes)
  if (snapshot.error) { process.stderr.write(snapshot.error + '\n'); return 1 }
  process.stdout.write(JSON.stringify({ profile: args.profile, url: args.url, ...snapshot.value }, null, 2) + '\n')
  return 0
}

/** Format the marker time like Python's `%Y-%m-%dT%H:%M:%S%z`, with the local UTC offset. */
function localStamp(now = new Date()) {
  const pad = value => String(value).padStart(2, '0')
  const offset = -now.getTimezoneOffset()
  const sign = offset >= 0 ? '+' : '-'
  return `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}T${pad(now.getHours())}:${pad(now.getMinutes())}:${pad(now.getSeconds())}`
    + `${sign}${pad(Math.floor(Math.abs(offset) / 60))}${pad(Math.abs(offset) % 60)}`
}

/** Ask DSH to exit through its management stop route; the route drains Executors and lets the launcher exit. */
export function stopRequest(url) {
  return apiRequest(url, 'POST', '/orchestrator/api/service/stop', { 'x-orchestrator-request': '1', 'content-length': '0' }, 10_000)
}

async function stop(args, intentional = true) {
  const pids = processes(args.profile)
  if (pids.length > 1) throw new Error('Multiple dsh-superagent processes found; refusing to choose one.')
  // Write the stop marker before waiting so monitors respect the intentional stop even if graceful shutdown times out.
  if (intentional) writeFileSync(join(control(args.profile), 'manually-stopped'), localStamp() + '\n')
  if (WINDOWS) {
    if (pids.length) await stopRequest(args.url)
  } else {
    for (const pid of pids) process.kill(pid, 'SIGINT')
  }
  const deadline = Date.now() + args.stop_timeout * 1000
  while (pids.some(pid => running(pid, args.profile))) {
    if (Date.now() >= deadline) throw new Error('Graceful stop timed out; no forced kill was sent. Check status.')
    await sleep(500)
  }
  rmSync(join(control(args.profile), 'service.pid'), { force: true })
  process.stdout.write(intentional ? 'dsh-superagent stopped. Automatic recovery is paused until start/restart.\n' : 'dsh-superagent stopped.\n')
}

function profileLogName(profile) {
  return new RegExp(`^dsh-superagent-${profile.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')}-\\d{8}-\\d{6}-\\d+\\.log$`)
}

/** Retain only the newest `KEEP_LOGS` log files for `profile`. */
function pruneLogs(profile) {
  const name = profileLogName(profile)
  const logs = readdirSync(ARTIFACTS).filter(entry => name.test(entry)).map(entry => join(ARTIFACTS, entry))
    .sort((a, b) => statSync(a).mtimeMs - statSync(b).mtimeMs)
  for (const path of logs.slice(0, Math.max(0, logs.length - KEEP_LOGS))) rmSync(path, { force: true })
}

function findExecutable(name) {
  const extensions = WINDOWS ? (process.env.PATHEXT ?? '.COM;.EXE;.BAT;.CMD').split(';').map(extension => extension.toLowerCase()).filter(Boolean) : ['']
  for (const directory of (process.env.PATH ?? '').split(delimiter).filter(Boolean)) {
    for (const extension of extensions) {
      const candidate = join(directory, name + extension)
      try {
        if (!statSync(candidate).isFile()) continue
        if (!WINDOWS) accessSync(candidate, constants.X_OK)
        return candidate
      } catch { /* Try the next candidate. */ }
    }
  }
  return undefined
}

/** Quote one word for a POSIX shell, as `shlex.quote` does. */
function shellQuote(word) {
  if (/^[A-Za-z0-9_@%+=:,./-]+$/.test(word)) return word
  return `'${word.replaceAll("'", "'\\''")}'`
}

/** The shell command a tmux pane runs: the caller's profile environment, without the tmux server's. */
export function tmuxCommand(dsh, profile, log, environment = process.env) {
  const values = ['DSH_HOME', 'HOME', 'PATH'].map(name => environment[name] === undefined
    ? `unset ${name}`
    : `export ${name}=${shellQuote(environment[name])}`)
  return `umask 077; ${values.join('; ')}; unset TMUX TMUX_PANE; exec `
    + `${[dsh, '--profile', profile, '--no-open'].map(shellQuote).join(' ')} >> ${shellQuote(log)} 2>&1`
}

/** The arguments that start the service in a tmux session; exported so the POSIX and Windows forms are testable. */
export function tmuxStart(target, dsh, profile, log, root = ROOT) {
  return [...target, '-d', '-P', '-F', '#{pane_pid}', '-n', 'server', '-c', root, tmuxCommand(dsh, profile, log)]
}

/** The profile-specific tmux socket name; a worker's `tmux kill-server` must not reach the service. */
export function tmuxSocket(profile) {
  return 'dsh-superagent-' + createHash('sha256').update(profile).digest('hex').slice(0, 20)
}

/** The invocation that starts the service detached on Windows; `dsh` is normally the npm `.cmd` shim. */
export function windowsStart(dsh, profile, node = findExecutable('node')) {
  if (/\.(cmd|bat)$/i.test(dsh)) {
    let text = ''
    try { text = readFileSync(dsh, 'utf8') } catch {}
    const entry = /(?:%~?dp0%?)[\\/]([^"'\r\n]+?\.(?:js|cjs|mjs))/i.exec(text)?.[1]
    if (entry) {
      const script = join(dirname(dsh), ...entry.split(/[\\/]+/))
      const adjacentNode = join(dirname(dsh), 'node.exe')
      const executable = existsSync(adjacentNode) ? adjacentNode : node
      if (!executable) throw new Error('node must be on PATH to start the npm dsh shim.')
      if (!existsSync(script)) throw new Error(`The dsh shim's Node entry does not exist: ${script}`)
      return { file: executable, args: [script, '--profile', profile, '--no-open'], shell: false }
    }
  }
  return { file: /\s/.test(dsh) ? `"${dsh}"` : dsh, args: ['--profile', profile, '--no-open'], shell: true }
}

export function restrictWindowsLog(path, run = spawnSync) {
  // Both helpers are non-interactive console programs: hide their windows so a background start does not flash them.
  const identity = run('whoami.exe', ['/user', '/fo', 'csv', '/nh'], { encoding: 'utf8', windowsHide: true })
  const sid = /S-1-(?:\d+-)+\d+/i.exec(identity.stdout ?? '')?.[0]
  if (identity.error || identity.status !== 0 || !sid) throw new Error('Could not identify the current Windows user for log access.')
  const permissions = run('icacls.exe', [path, '/inheritance:r', '/grant:r', `*${sid}:(F)`, '*S-1-5-18:(F)', '*S-1-5-32-544:(F)'],
    { encoding: 'utf8', windowsHide: true })
  if (permissions.error || permissions.status !== 0) throw new Error(`Could not restrict access to the service log: ${(permissions.stderr ?? '').trim()}`)
}

async function start(args) {
  const session = 'dsh-' + args.profile
  let pids = processes(args.profile)
  if (pids.length > 1) throw new Error('Multiple dsh-superagent processes found; refusing to start another.')
  let method = pids.length ? 'existing' : undefined
  let outsideJobLog
  let outsideJobEnvironment
  if (!pids.length) {
    // A DSH tool command runs in a Windows Job with kill-on-close, so a service started there looks healthy only until
    // that command ends. The WMI provider creates a process outside every Job; the environment is passed explicitly.
    let outsideJob = false
    if (WINDOWS && !args.outside_job_child) {
      const membership = processInJob(process.pid)
      if (membership === null) {
        throw new Error('Cannot determine whether this process is inside a Windows Job; refusing to start a service that '
          + 'a closing Job could kill. Run the service from an independent task or terminal.')
      }
      outsideJob = membership
    }
    const dsh = outsideJob ? 'dsh' : findExecutable('dsh')
    const tmux = WINDOWS || outsideJob ? 'tmux' : findExecutable('tmux')
    if (!outsideJob && (!dsh || !tmux)) throw new Error(WINDOWS ? 'dsh must be on PATH.' : 'Both dsh and tmux must be on PATH.')
    const socket = WINDOWS || outsideJob ? undefined : tmuxSocket(args.profile)
    // Probe the tmux session before the URL so an existing orchestrator is still refused without touching tmux.
    const sessionExists = WINDOWS || outsideJob ? false : spawnSync('tmux', ['-L', socket, 'has-session', '-t', '=' + session]).status === 0
    if (await state(args.url) !== null) throw new Error('An existing orchestrator answers at this URL; refusing duplicate startup.')
    mkdirSync(ARTIFACTS, { recursive: true })
    const stamp = new Date()
    const pad = value => String(value).padStart(2, '0')
    const log = join(ARTIFACTS, `dsh-superagent-${args.profile}-${stamp.getFullYear()}${pad(stamp.getMonth() + 1)}${pad(stamp.getDate())}`
      + `-${pad(stamp.getHours())}${pad(stamp.getMinutes())}${pad(stamp.getSeconds())}-${process.pid}.log`)
    if (outsideJob) {
      const wrapper = join(ROOT, 'scripts', 'service-start.ps1')
      if (!existsSync(wrapper)) throw new Error(`Cannot start outside a Windows Job: ${wrapper} is missing.`)
      // The same prune-friendly name the ordinary service log uses; the child's service log has its own PID.
      outsideJobLog = log
      outsideJobEnvironment = writeStartEnvironment(args.profile)
      const shell = findExecutable('pwsh') ?? 'powershell.exe'
      const commandLine = outsideJobStartCommand({ shell, wrapper, checkout: ROOT, environmentFile: outsideJobEnvironment,
        profile: args.profile, url: args.url, timeout: args.timeout, log: outsideJobLog })
      try {
        createOutsideJob(commandLine, ROOT)
      } catch (error) {
        rmSync(outsideJobEnvironment, { force: true })
        throw new Error('Could not start the service outside the current Windows Job: '
          + (error instanceof Error ? error.message : String(error)))
      }
      method = 'wmi'
      process.stdout.write(`This process is inside a Windows Job; starting the service outside it through ${basename(wrapper)}.\n`)
    } else {
      writeFileSync(log, '', { mode: 0o600 })
      if (WINDOWS) restrictWindowsLog(log)
      pruneLogs(args.profile)
      if (WINDOWS) {
        const invocation = windowsStart(dsh, args.profile)
        const environment = { ...process.env }
        delete environment.TMUX
        delete environment.TMUX_PANE
        const output = openSync(log, 'a')
        const child = spawn(invocation.file, invocation.args, { detached: true, shell: invocation.shell, stdio: ['ignore', output, output],
          cwd: ROOT, windowsHide: true, env: environment })
        child.unref()
        closeSync(output)
        // The recorded PID is a convenience; the process scan is authoritative after a restart.
        const deadline = Date.now() + 5_000
        while (Date.now() < deadline && !processes(args.profile).length) await sleep(200)
        pids = processes(args.profile)
        if (pids.length) writeFileSync(join(control(args.profile), 'service.pid'), `${pids[0]}\n`)
        method = 'spawn'
      } else {
        const target = sessionExists ? ['new-window', '-t', '=' + session + ':'] : ['new-session', '-s', session]
        const started = spawnSync('tmux', ['-L', socket, ...tmuxStart(target, dsh, args.profile, log)], { encoding: 'utf8' })
        if (started.error) throw started.error
        if (started.status !== 0) throw new Error((started.stderr ?? '').trim() || `tmux exited with code ${started.status}`)
        const pane = (started.stdout ?? '').trim()
        if (/^\d+$/.test(pane)) writeFileSync(join(control(args.profile), 'service.pid'), pane + '\n')
        method = 'tmux'
      }
    }
    process.stdout.write('Log: ' + (outsideJob ? outsideJobLog : log) + '\n')
  } else {
    writeFileSync(join(control(args.profile), 'service.pid'), `${pids[0]}\n`)
    process.stdout.write(`dsh-superagent already running (PID ${pids[0]}); no duplicate started.\n`)
  }
  rmSync(join(control(args.profile), 'manually-stopped'), { force: true })
  // A wrapper child only launches the detached service; the parent that holds the profile lock waits for health.
  if (args.outside_job_child) return 0
  const deadline = Date.now() + args.timeout * 1000
  while (Date.now() < deadline) {
    const current = await state(args.url)
    if (processes(args.profile).length && runtimeUp(current)) {
      const inspected = await statusValue(args)
      process.stdout.write(JSON.stringify(inspected.value, null, 2) + '\n')
      const code = outcome(inspected.pids, inspected.current)
      if (current.setup) {
        process.stdout.write('dsh-superagent is waiting for setup: ' + String(current.setup.detail ?? '') + '\n')
        process.stdout.write('Open the URL DSH printed in the log, then the dsh-superagent overview.\n')
      }
      if (current.feishu) {
        process.stdout.write('dsh-superagent runs without Feishu: ' + String(current.feishu.detail ?? '') + '\n')
        process.stdout.write('Fix it on the Feishu card of the Source settings.\n')
      }
      for (const [name, detail] of Object.entries(partErrors(current))) {
        process.stdout.write(`${name} reports an error, which a restart does not fix: ${detail}\n`)
      }
      if (method !== 'existing' && inspected.pids.length === 1) {
        recordStartFacts(args.profile, { at: new Date().toISOString(), pid: inspected.pids[0], method,
          inJob: inspected.inJob, foreignJob: inspected.foreignJob, url: args.url, launchedBy: process.pid })
      }
      if (outsideJobEnvironment) rmSync(outsideJobEnvironment, { force: true })
      if (WINDOWS && method !== 'existing') {
        if (inspected.foreignJob !== false) {
          process.stderr.write('The service is not provably outside every Windows Job it did not create; a Job it inherited '
            + 'from the launch chain could still kill it.\n')
          return 1
        }
      } else if (WINDOWS && inspected.foreignJob === true) {
        process.stderr.write('Warning: this running service belongs to a Windows Job it did not create and can be killed '
          + 'when that Job closes; restart it from an independent task during a maintenance window.\n')
      }
      return code
    }
    await sleep(1000)
  }
  if (outsideJobLog) {
    const tail = logTail(outsideJobLog)
    if (tail) process.stderr.write('The independent start wrapper logged:\n' + tail + '\n')
  }
  await status(args)
  throw new Error('Startup health check timed out; inspect the log. Any running process was left intact.')
}

/** Parse the command line the way the previous `argparse` interface did, including options before the action. */
export function parseArgv(argv, env = process.env) {
  const args = { action: undefined, watchdog_action: undefined, chat: undefined, note: undefined,
    ticket: undefined, reason: undefined, snapshot_at: undefined, idempotency_key: undefined,
    profile: env.DSH_SUPERAGENT_PROFILE || 'superagent', url: env.DSH_SUPERAGENT_URL || 'http://127.0.0.1:3082',
home: env.DSH_HOME || join(homedir(), '.dsh'), timeout: 60, stop_timeout: 300, stale_minutes: 30, limit: 20,
    respect_stop: false, survival_seconds: 20, outside_job_child: false }
  const positionals = []
  const value = (index, name) => {
    const next = argv[index + 1]
    if (next === undefined || next.startsWith('-')) throw new Error(`${name} needs a value`)
    return next
  }
  /** A value that may itself start with `-`, such as a note written as a sentence. */
  const text = (index, name) => {
    const next = argv[index + 1]
    if (next === undefined) throw new Error(`${name} needs a value`)
    return next
  }
  for (let index = 0; index < argv.length; index++) {
    const word = argv[index]
    if (word === '--profile') { args.profile = value(index, '--profile'); index++ }
    else if (word.startsWith('--profile=')) args.profile = word.slice('--profile='.length)
    else if (word === '--home') { args.home = value(index, '--home'); index++ }
    else if (word.startsWith('--home=')) args.home = word.slice('--home='.length)
    else if (word === '--url') { args.url = value(index, '--url'); index++ }
    else if (word.startsWith('--url=')) args.url = word.slice('--url='.length)
    else if (word === '--timeout') { args.timeout = Number(value(index, '--timeout')); index++ }
    else if (word === '--stop-timeout') { args.stop_timeout = Number(value(index, '--stop-timeout')); index++ }
    else if (word === '--survival-seconds') { args.survival_seconds = Number(value(index, '--survival-seconds')); index++ }
    else if (word.startsWith('--survival-seconds=')) args.survival_seconds = Number(word.slice('--survival-seconds='.length))
    else if (word === '--stale-minutes') { args.stale_minutes = Number(value(index, '--stale-minutes')); index++ }
    else if (word.startsWith('--stale-minutes=')) args.stale_minutes = Number(word.slice('--stale-minutes='.length))
    else if (word === '--chat') { args.chat = value(index, '--chat'); index++ }
    else if (word.startsWith('--chat=')) args.chat = word.slice('--chat='.length)
    else if (word === '--note') { args.note = text(index, '--note'); index++ }
    else if (word.startsWith('--note=')) args.note = word.slice('--note='.length)
    else if (word === '--ticket') { args.ticket = value(index, '--ticket'); index++ }
    else if (word.startsWith('--ticket=')) args.ticket = word.slice('--ticket='.length)
    else if (word === '--reason') { args.reason = text(index, '--reason'); index++ }
    else if (word.startsWith('--reason=')) args.reason = word.slice('--reason='.length)
    else if (word === '--snapshot-at') { args.snapshot_at = value(index, '--snapshot-at'); index++ }
    else if (word.startsWith('--snapshot-at=')) args.snapshot_at = word.slice('--snapshot-at='.length)
    else if (word === '--idempotency-key') { args.idempotency_key = value(index, '--idempotency-key'); index++ }
    else if (word.startsWith('--idempotency-key=')) args.idempotency_key = word.slice('--idempotency-key='.length)
    else if (word === '--limit') { args.limit = Number(value(index, '--limit')); index++ }
    else if (word.startsWith('--limit=')) args.limit = Number(word.slice('--limit='.length))
    else if (word === '--respect-stop') args.respect_stop = true
    // Internal: a wrapper started outside every Windows Job spawns the service and returns immediately.
    else if (word === '--outside-job-child') args.outside_job_child = true
    else if (word === '-h' || word === '--help') args.help = true
    else if (word.startsWith('-')) throw new Error(`unrecognized option: ${word}`)
    else positionals.push(word)
  }
  args.action = positionals[0]
  if (args.action === 'watchdog') {
    args.watchdog_action = positionals[1]
    const actions = ['report', 'run', 'runs', 'recover']
    if (args.watchdog_action !== undefined && !actions.includes(args.watchdog_action)) {
      throw new Error('watchdog action must be report, run, runs or recover')
    }
    if (positionals.length > 2) throw new Error(`unexpected argument: ${positionals[2]}`)
    if (args.watchdog_action === 'report') {
      if (!args.chat) throw new Error('watchdog report needs --chat')
      if (!/^oc_[a-zA-Z0-9]+$/.test(args.chat)) throw new Error('--chat must be a Feishu chat id (oc_...)')
    }
    if ((args.watchdog_action === 'run' || args.watchdog_action === 'report') && args.note !== undefined
      && args.note.length > 500) throw new Error('--note must be at most 500 characters')
    if (args.watchdog_action === 'runs' && (!Number.isInteger(args.limit) || args.limit < 1 || args.limit > 100)) {
      throw new Error('--limit must be an integer between 1 and 100')
    }
    if (args.watchdog_action === 'recover') {
      if (!args.ticket) throw new Error('watchdog recover needs --ticket')
      if (!/^[A-Za-z0-9_-]{1,64}$/.test(args.ticket)) throw new Error('--ticket must name one Ticket')
      if (!args.reason) throw new Error('watchdog recover needs --reason')
      if (args.reason.length > 2000) throw new Error('--reason must be at most 2000 characters')
      if (!args.snapshot_at || !Number.isFinite(Date.parse(args.snapshot_at))) {
        throw new Error('watchdog recover needs a parseable --snapshot-at')
      }
      if (args.idempotency_key !== undefined && !/^[A-Za-z0-9._:-]{1,200}$/.test(args.idempotency_key)) {
        throw new Error('--idempotency-key must be 1-200 letters, digits or ._:-')
      }
    }
  } else if (positionals.length > 1) throw new Error(`unexpected argument: ${positionals[1]}`)
  if (args.help) return args
  if (!['start', 'stop', 'restart', 'status', 'watchdog', 'verify'].includes(args.action)) {
    throw new Error('action must be one of start, stop, restart, status, watchdog, verify')
  }
  if (!Number.isFinite(args.timeout) || !Number.isFinite(args.stop_timeout) || args.timeout <= 0 || args.stop_timeout <= 0) {
    throw new Error('--timeout and --stop-timeout must be positive')
  }
  if (!Number.isInteger(args.survival_seconds) || args.survival_seconds < 0 || args.survival_seconds > 3_600) {
    throw new Error('--survival-seconds must be an integer between 0 and 3600')
  }
  if (!Number.isInteger(args.stale_minutes) || args.stale_minutes < 1 || args.stale_minutes > 1440) {
    throw new Error('--stale-minutes must be an integer between 1 and 1440')
  }
  if (!/^[A-Za-z0-9_][A-Za-z0-9_.-]*$/.test(args.profile)) throw new Error('--profile must be a DSH profile name')
  args.home = resolve(args.home)
  return args
}

/** Take the profile's control lock without waiting; a stale lock from a crashed operation is removed after ten minutes. */
function acquireLock(profile) {
  const lock = join(control(profile), 'operation.lock')
  const take = () => { mkdirSync(lock); return () => rmSync(lock, { recursive: true, force: true }) }
  try { return take() } catch (error) {
    if (error?.code !== 'EEXIST') throw error
    try {
      if (Date.now() - statSync(lock).mtimeMs < LOCK_STALE_MS) throw error
      rmSync(lock, { recursive: true, force: true })
      return take()
    } catch (retry) {
      if (retry?.code === 'EEXIST') throw new Error('Another dsh-superagent control operation is in progress.')
      throw retry
    }
  }
}

const USAGE = `Usage: dsh-superagent [--respect-stop] <start|stop|restart|status|watchdog|verify> [options]

Manage a local dsh-superagent service (one DSH profile, default \`superagent\`).

\`start\` and \`restart\` start the service outside any Windows Job when the caller is inside one, so a closing DSH tool
command cannot kill it; \`status\` reports the process's Job membership and how the newest start began. A service that
spawns a child joins its own kill-on-close Job, which it holds, so \`status\` separates that from a Job it inherited.
\`verify\` proves the service survived a deployment executor's exit: one process, the management API usable, no Windows
Job it did not create, and the same process after --survival-seconds.
\`watchdog\` prints a read-only JSON snapshot of the service, its open Tickets and the last recorded observation;
\`watchdog run [--note <text>]\` records one observation run from the live snapshot, even when nothing is flagged;
\`watchdog runs [--limit <n>]\` prints recent observation runs, newest first;
\`watchdog recover --ticket <id> --reason <text> --snapshot-at <time>\` asks for one bounded retry of a Ticket whose
worker Session is missing, when the service's recovery mode is enforce;
\`watchdog report --chat <chat id> [--note <text>]\` asks the server to send the current observation summary to that
Feishu chat through the Feishu Source's bot.

Options:
  --profile <name>       DSH profile that loads dsh-superagent (default: $DSH_SUPERAGENT_PROFILE or superagent).
  --home <path>          DSH home holding that profile (default: $DSH_HOME or ~/.dsh); \`status\` reports it.
  --url <url>            Health-check URL (default: $DSH_SUPERAGENT_URL or http://127.0.0.1:3082).
  --timeout <seconds>    Startup timeout (default: 60).
  --stop-timeout <s>     Graceful shutdown timeout (default: 300).
  --survival-seconds <n> How long \`verify\` waits before its second health check (default: 20, at most 3600).
  --stale-minutes <n>    Watchdog signal threshold in minutes (default: 30, at most 1440).
  --chat <chat id>       Feishu chat that \`watchdog report\` posts to (required, an \`oc_\` id the bot is in).
  --note <text>          The Watchdog's one-sentence judgement for \`watchdog run\` or \`watchdog report\` (at most 500 characters).
  --ticket <id>          Ticket for \`watchdog recover\`.
  --reason <text>        One-sentence evidence for \`watchdog recover\` (at most 2000 characters).
  --snapshot-at <time>   The snapshot's \`at\` value for \`watchdog recover\`; an older one is refused.
  --idempotency-key <k>  Optional stable recovery key; the default names the Ticket and snapshot.
  --limit <n>            How many recent runs \`watchdog runs\` prints (default: 20, at most 100).
  --respect-stop         For monitoring: never start/restart after an intentional stop.`

async function main(argv = process.argv.slice(2)) {
  const args = parseArgv(argv)
  if (args.help) { process.stdout.write(USAGE + '\n'); return 0 }
  process.umask(0o077)
  // A Watchdog only reads the management API, so a control operation in progress must not block it.
  if (args.action === 'watchdog') {
    if (args.watchdog_action === 'run') return await watchdogRecord(args)
    if (args.watchdog_action === 'runs') return await watchdogRuns(args)
    if (args.watchdog_action === 'recover') return await watchdogRecover(args)
    return args.watchdog_action === 'report' ? await watchdogReport(args) : await watchdog(args)
  }
  // The wrapper runs only after the locked parent asked it to spawn the detached service; it must not take the lock.
  if (args.outside_job_child) {
    if (args.action !== 'start') throw new Error('--outside-job-child is only valid for start')
    return await start(args)
  }
  const release = acquireLock(args.profile)
  try {
    if (args.respect_stop && (args.action === 'start' || args.action === 'restart') && stopped(args.profile)) {
      process.stdout.write('Intentional stop is active; automatic recovery skipped.\n')
      return 0
    }
    if (args.action === 'status') return await status(args)
    if (args.action === 'verify') return await verify(args)
    if (args.action === 'stop' || args.action === 'restart') {
      // Only a stop keeps automatic recovery off; a restart whose stop timed out leaves it on.
      await stop(args, args.action === 'stop')
    }
    if (args.action === 'start' || args.action === 'restart') return await start(args)
    return 0
  } finally { release() }
}

if (process.argv[1] && (() => { try { return realpathSync(resolve(process.argv[1])) === SCRIPT } catch { return false } })()) {
  main().then(code => { process.exitCode = code }).catch(error => {
    process.stderr.write((error instanceof Error ? error.message : String(error)) + '\n')
    process.exitCode = 1
  })
}